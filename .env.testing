APP_NAME=MolMeDB
APP_ENV=testing
APP_KEY=base64:tkYaoUuVwWHdkL9nSdwQq59njIJm7Uvio1Me2Ahwo/U=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
# Must be "predictions" (the dedicated connection, config/database.php),
# not "sqlite" — Modules\PredictionWorkers\Models\PredictionBaseModel reads
# config('database.default_predictions') as a literal connection *name* to
# use, and the generic "sqlite" connection shares DB_DATABASE with the main
# app connection above, which silently breaks the moment anything (e.g. a
# CI job) overrides DB_DATABASE for a real database.
DB_PREDICTIONS_CONNECTION=predictions
DB_PREDICTIONS_DRIVER=sqlite
DB_PREDICTIONS_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# config/database.php defaults REDIS_CLIENT to "phpredis" (the native PECL
# extension) when unset, which isn't installed here or in CI — the app
# actually uses predis (a pure-PHP client, see composer.json / .env) so any
# code path that touches Redis directly fails with "Class Redis not found"
# without this.
REDIS_CLIENT=predis
