FRONTEND_URL=http://localhost:3000
NEXT_SELF_URL=http://localhost:3000 # internal self-call URL (HTTP, no SSL); overrides FRONTEND_URL for server-side self-fetch
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_BACKEND_URL=http://web:80
NODE_ENV=develop # production

NEXT_PUBLIC_API_LOGGING=false # set to "true" to enable API request/error logging to console

NEXT_PUBLIC_TURNSTILE_SITE_KEY=TOKEN

JWT_SECRET=SUPER_SECRET_KEY

COOKIES_BACKEND_XSRF_KEY=XSRF-TOKEN
COOKIES_BACKEND_SESSION_KEY=molmedb_session
COOKIES_FRONTEND_SESSION_KEY=molmedb_fe_session
COOKIES_FRONTEND_SESSION_USER_KEY=molmedb_fe_session_user